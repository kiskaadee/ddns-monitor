# ── Rust / Cargo ───────────────────────────────────────────────────────────────
/target/
Cargo.lock          # library crates omit it; for binaries keep it — uncomment if you want

# ── Nix ────────────────────────────────────────────────────────────────────────
result
result-*
.direnv/

# ── Secrets & credentials ───────────────────────────────────────────────────────
# Never commit plaintext secrets, tokens, or API keys.
*.secret
*.key
*.pem
*.p12
*.pfx
secrets/
.env
.env.*
config.toml               # local dev config may contain credential paths — keep out
# local dev credentials for live contract harness
tests/contracts/*.local.toml
tests/contracts/contracts.toml

# ── Python / Virtualenv ────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

# ── Runtime state ──────────────────────────────────────────────────────────────
# Generated by the binary at runtime; not source artifacts.
state.json
*.jsonl
ip_history.jsonl

# ── Editor / OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ───────────────────────────────────────────────────────────────────────
*.log
.agents/
